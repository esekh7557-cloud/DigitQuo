# Copy this file to `.env` at the project root for local runs, or set the same
# variables in your hosting provider's environment settings.
# App / deployment
APP_BASE_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Apirone wallet IDs used by the crypto checkout
APIRONE_BTC_WALLET_ID=
APIRONE_LTC_WALLET_ID=
APIRONE_DOGE_WALLET_ID=
APIRONE_BCH_WALLET_ID=
APIRONE_TRX_WALLET_ID=
APIRONE_ETH_WALLET_ID=
APIRONE_BNB_WALLET_ID=
APIRONE_TBTC_WALLET_ID= # testnet only

# Optional: keep transfer keys here if you want them in env for later use
APIRONE_BTC_TRANSFER_KEY=
APIRONE_LTC_TRANSFER_KEY=
APIRONE_DOGE_TRANSFER_KEY=
APIRONE_BCH_TRANSFER_KEY=
APIRONE_TRX_TRANSFER_KEY=
APIRONE_ETH_TRANSFER_KEY=
APIRONE_BNB_TRANSFER_KEY=
APIRONE_TBTC_TRANSFER_KEY=
